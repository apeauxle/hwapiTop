short_name() { # short_name NAME -> REPLY = short English display label
    local n=$1
    [[ -n ${SHORTMAP[$n]+x} ]] && { REPLY=${SHORTMAP[$n]}; return; }
    # per-core forms: "Core N T0 Эффективная частота", "Core N Частота
    # (perf #a/b)", "Core N Множитель", "Core N Потребляемая мощность", ...
    local re
    re='^Core ([0-9]+) (T[01]) Эффективная частота$'
    [[ $n =~ $re ]] && { REPLY="C${BASH_REMATCH[1]}${BASH_REMATCH[2]} eff"; return; }
    re='^Core ([0-9]+) (T[01]) Использование$'
    [[ $n =~ $re ]] && { REPLY="C${BASH_REMATCH[1]}${BASH_REMATCH[2]}"; return; }
    re='^Core ([0-9]+) Частота'
    [[ $n =~ $re ]] && { REPLY="C${BASH_REMATCH[1]} clk"; return; }
    re='^Core ([0-9]+) Множитель$'
    [[ $n =~ $re ]] && { REPLY="C${BASH_REMATCH[1]} ratio"; return; }
    re='^Core ([0-9]+) Потребляемая мощность$'
    [[ $n =~ $re ]] && { REPLY="C${BASH_REMATCH[1]} pwr"; return; }
    re='^Core ([0-9]+) VID$'
    [[ $n =~ $re ]] && { REPLY="C${BASH_REMATCH[1]} VID"; return; }
    re='^Core ([0-9]+) C([0-6]) Резидентность$'
    [[ $n =~ $re ]] && { REPLY="C${BASH_REMATCH[1]} C${BASH_REMATCH[2]}"; return; }
    re='^Core([0-9]+) \(CCD([0-9]+)\)$'
    [[ $n =~ $re ]] && { REPLY="C${BASH_REMATCH[1]}"; return; }
    # sensor group names: "ЦП [#0]: AMD Ryzen 5 5600", "dGPU [#0]: ...",
    # "Drive: X (serial) [C:]", "S.M.A.R.T.: ..." -- keep the tail
    re='^(ЦП|GPU|dGPU|Drive|S\.M\.A\.R\.T\.|Сеть)\[#0\]: +(.*)$'
    [[ $n =~ $re ]] && { n=${BASH_REMATCH[2]}; }
    re='^(.*): +Enhanced$'
    [[ $n =~ $re ]] && { REPLY="${BASH_REMATCH[1]}"; return; }
    # last resort: transliterate common Russian words, trim
    n=${n%% (*}
    n=${n//ГП/GPU}; n=${n//ЦП/CPU}; n=${n//Температура/temp}; n=${n//Напряжение/V}
    n=${n//Потребляемая мощность/pwr}; n=${n//Использование/load}; n=${n//Частота/clk}
    n=${n//Резидентность/res}
    trunc "$n" 14
    REPLY=${REPLY%% }
}
disp_name() { # disp_name SENSOR-NAME -> REPLY = short display name
    # "ЦП [#0]: AMD Ryzen 5 5600: Enhanced" -> "AMD Ryzen 5 5600"
    # "dGPU [#0]: AMD Radeon RX 6700 XT: MSI ..." -> "RX 6700 XT"
    # "Drive: ADATA SE760 (429084B4600E) [E:]" -> "ADATA SE760 [E:]"
    local n=$1 re
    re='^(ЦП|GPU|dGPU) \[#0\]: +'
    [[ $n =~ $re ]] && n=${n:${#BASH_REMATCH[0]}}
    re='^(Drive|S\.M\.A\.R\.T\.): +'
    [[ $n =~ $re ]] && n=${n:${#BASH_REMATCH[0]}}
    re='^(.*): +(Enhanced|C-State.*|Power|Clocks?|Voltages?)$'
    [[ $n =~ $re ]] && n=${BASH_REMATCH[1]}
    # drop the serial/paren tail of drive names, keep the partition letter
    re='^(.*) \([A-Z0-9]+\)( \[.:\])?$'
    [[ $n =~ $re ]] && n="${BASH_REMATCH[1]}${BASH_REMATCH[2]}"
    # GPU: "AMD Radeon RX 6700 XT: MSI RX 6700 XT MECH 2X OC 12G" -> "RX 6700 XT"
    re='^(AMD )?Radeon (RX [0-9]+ ?[A-Za-z]*)'
    [[ $n =~ $re ]] && { REPLY="${BASH_REMATCH[2]% }"; return; }
    re='^(NVIDIA )?(GeForce )?(RTX|GTX) ([0-9]+.*)'
    [[ $n =~ $re ]] && { REPLY="${BASH_REMATCH[3]} ${BASH_REMATCH[4]}"; return; }
    # NIC: "Сеть: Intel I211AT Copper (...)" -> "Intel I211AT"
    re='^(Сеть|Network): +'
    [[ $n =~ $re ]] && n=${n:${#BASH_REMATCH[0]}}
    re='^(Intel|Realtek|Broadcom|Qualcomm|MediaTek|Killer) ([A-Z0-9]+)'
    [[ $n =~ $re ]] && { REPLY="${BASH_REMATCH[1]} ${BASH_REMATCH[2]}"; return; }
    # board: "ASRock B450 Gaming-ITX/ac (Nuvoton NCT6792D)" -> "ASRock B450"
    re='^(ASRock|ASUS|Gigabyte|MSI|Biostar) ([A-Z0-9]+)'
    [[ $n =~ $re ]] && { REPLY="${BASH_REMATCH[1]} ${BASH_REMATCH[2]}"; return; }
    # "Тайминги памяти" -> "RAM timings"; process/thread panels keep their tag
    [[ $n == "Тайминги памяти" ]] && { REPLY="RAM timings"; return; }
    re='^(PresentMon|RTSS)'
    [[ $n =~ $re ]] && { REPLY="${BASH_REMATCH[1]}"; return; }
    trunc "$n" 24
    REPLY=${REPLY%% }
}
# ----------------------------------------------------------------- history
H_MAX=300
declare -a H_CT=() H_CP=() H_GT=() H_ML=() H_DN=() H_UP=()

hpush() { # hpush ARRAY VALUE
    local -n h=$1
    h+=("$2")
    while ((${#h[@]} > H_MAX)); do h=("${h[@]:1}"); done
}

spark() { # spark ARRAY WIDTH MAX -> REPLY (plain, right-aligned)
    local -n h=$1
    local w=$2 max=$3
    [[ $max =~ ^[0-9]+$ ]] || max=1
    ((max < 1)) && max=1
    local chars=(▁ ▂ ▃ ▄ ▅ ▆ ▇ █)
    local n=${#h[@]} out="" i k v first
    if ((n == 0 || w < 1)); then REPLY=""; return; fi
    first=0
    ((n > w)) && first=$((n - w))
    rep ' ' $((w - (n - first))); out=$REPLY
    for ((i = first; i < n; i++)); do
        v=${h[i]}
        [[ $v =~ ^-?[0-9]+$ ]] || v=0
        k=$(( (v * 8 + max - 1) / max ))
        ((k < 1)) && k=1
        ((k > 8)) && k=8
        out+="${chars[k - 1]}"
    done
    REPLY=$out
}

graph() { # graph ARRAY ROWS WIDTH MAX COLOR [LABEL] [MIN] -> REPLY (\n-joined)
    # Multi-row graph: each column is blocks stacked up from the bottom, so the
    # vertical resolution is ROWS*8 steps. Values above MAX clip to the top.
    # Samples fill from the left and scroll left once they no longer fit.
    local -n h=$1
    local rows=$2 w=$3 max=$4 col=$5 label=${6:-} min=${7:-0}
    [[ $max =~ ^[0-9]+$ ]] || max=1
    ((max < 1)) && max=1
    [[ $min =~ ^-?[0-9]+$ ]] || min=0
    local range=$(( max - min ))
    ((range < 1)) && range=1
    ((rows < 1 || w < 1)) && { REPLY=""; return; }
    local n=${#h[@]} first=0 pad=w
    ((n > w)) && first=$(( n - w ))
    ((n < w)) && pad=$(( w - n ))
    local span=$(( rows * 8 ))
    local -a level=()
    local i v l ci
    for ((ci = 0; ci < w; ci++)); do
        if ((ci < pad)); then level+=(-1); continue; fi
        i=$(( first + ci - pad ))
        if ((i < 0 || i >= n)); then level+=(-1); continue; fi
        v=${h[i]}
        [[ $v =~ ^-?[0-9]+$ ]] || v=0
        l=$(( ((v - min) * span + range / 2) / range ))
        ((l < 0)) && l=0
        ((l > span)) && l=span
        level+=("$l")
    done
    local r base e glyph text line
    local -a lines=()
    for ((r = rows - 1; r >= 0; r--)); do
        base=$(( r * 8 ))
        line=""
        for ((ci = 0; ci < w; ci++)); do
            l=${level[ci]}
            e=$(( l - base ))
            if ((e <= 0)); then line+=" "
            elif ((e >= 8)); then line+="█"
            else
                case $e in
                    1) line+="▁" ;; 2) line+="▂" ;; 3) line+="▃" ;; 4) line+="▄" ;;
                    5) line+="▅" ;; 6) line+="▆" ;; 7) line+="▇" ;;
                    *) line+="█" ;;
                esac
            fi
        done
        lines+=("${col}${line}${R}")
    done
    if [[ -n $label ]]; then
        # btop-style label painted over the bottom row's leftmost columns
        local last=$(( rows - 1 ))
        local body=${lines[last]}
        body=${body#"${col}"}
        body=${body%"${R}"}
        local nlab=${#label}
        lines[last]="${col}${C_LBL}${label}${col}${body:nlab}${R}"
    fi
    local IFS=$'\n'
    REPLY="${lines[*]}"
}

graph_rows() { # graph_rows ARRAY COUNT WIDTH MAX COLOR [LABEL] [MIN] -> GRAPH_LINES
    local out
    graph "$@"
    out=$REPLY
    GRAPH_LINES=()
    local l
    while IFS= read -r l; do GRAPH_LINES+=("$l"); done <<<"$out"
}

hmin() { # hmin ARRAY -> REPLY min value (0 when empty)
    local -n h=$1
    local v m=-1
    for v in "${h[@]}"; do
        [[ $v =~ ^-?[0-9]+$ ]] || continue
        if ((m < 0 || v < m)); then m=$v; fi
    done
    ((m < 0)) && m=0
    REPLY=$m
}

hmax() { # hmax ARRAY -> REPLY max value
    local -n h=$1
    local v m=0
    for v in "${h[@]}"; do
        [[ $v =~ ^-?[0-9]+$ ]] || continue
        ((v > m)) && m=$v
    done
    ((m < 1)) && m=1
    REPLY=$m
}

# ------------------------------------------------------------------ panels
# Every build_$NAME W H fills a global array with exactly H lines of width W.
# Panels compose from: p_start / p_row / p_rule / p_graph / p_blank / p_end,
# and p_finish pads them out. Nothing here may leave REPLY from one helper
# visible to the next: capture results into locals immediately.

fmt1() { # fmt1 RAW -> REPLY one decimal, or "--"
    fmtval "${1:-}" 1
    [[ -n $REPLY ]] || REPLY="--"
}
fmt0() { # fmt0 RAW -> REPLY no decimals, or "--"
    fmtval "${1:-}" 0
    [[ -n $REPLY ]] || REPLY="--"
}
reading() { # reading INDEX DIGITS -> VALUE (formatted or "--")
    val_of "$1"
    fmtval "$REPLY" "$2"
    [[ -n $REPLY ]] || REPLY="--"
    VALUE=$REPLY
}

p_graph_temp() { # p_graph_temp ARRAY ROWS [LABEL] -> graph autoscaled to the data
    # A fixed C axis flattens a real trace into one solid row: 4 rows over a
    # 70-degree window is ~2 C per row. Scale to the observed min/max instead,
    # with a little headroom so the newest peak does not touch the ceiling.
    local arr=$1 rows=$2 label=${3:-} peak lo pad
    hmax "$arr"; peak=$REPLY
    hmin "$arr"; lo=$REPLY
    pad=$(( (peak - lo) / 8 ))
    ((pad < 2)) && pad=2
    peak=$(( peak + pad ))
    lo=$(( lo - pad ))
    ((lo < 0)) && lo=0
    ((peak - lo < 4)) && peak=$(( lo + 4 ))
    p_graph "$arr" "$rows" "$peak" "$label" "$lo"
}

p_graph() { # p_graph ARRAY ROWS MAX [LABEL] [MIN] -> append ROWS graph lines
    local arr=$1 rows=$2 max=${3:-0} label=${4:-} min=${5:-0} i
    ((rows < 1)) && return 0
    if [[ $max == 0 ]]; then hmax "$arr"; max=$REPLY; fi
    ((max <= min)) && max=$(( min + 1 ))
    graph_rows "$arr" "$rows" $(( P_W - 2 )) "$max" "$C_DIM" "$label" "$min"
    for i in "${GRAPH_LINES[@]}"; do
        P_LINES+=("${C_BRD}│${R}${i}${C_BRD}│${R}")
    done
}

build_header() { # W -> HEADER_LINES
    local w=$1 iw=$(( w - 2 ))
    local now dot state col left right lw rw gap line t
    now=$(date +%H:%M:%S)
    local DROP=0
    ((LINE_LOST >= 3)) && DROP=1
    if ((DROP)); then dot="●"; state="NO DATA"; col=$C_BAD
    elif ((STALE)); then dot="●"; state="OFFLINE"; col=$C_BAD
    elif ((PAUSED)); then dot="●"; state="PAUSED"; col=$C_WARN
    else dot="●"; state="LIVE"; col=$C_OK; fi
    left=" ${C_ACC}${BASE_URL}${R}  ${col}${dot} ${state}${R}"
    left+="  ${C_LBL}read${R} ${READ_RTT}ms  ${C_LBL}poll${R} ${INTERVAL}s"
    [[ -n $SRV_VER ]] && left+="  ${C_LBL}api v${R}${SRV_VER}"
    if [[ -n $LAST_ERR ]]; then trunc "$LAST_ERR" 40; left+="  ${C_BAD}${REPLY}${R}"; fi
    right="${C_LBL}updates ${R}${POLLS}  ${BOLD}${now}${R} "
    vislen "$left";  lw=$VLEN
    vislen "$right"; rw=$VLEN
    gap=$(( iw - lw - rw ))
    ((gap < 0)) && gap=0
    rep ' ' "$gap"
    if ((lw + rw <= iw)); then
        line="${left}${REPLY}${right}"
    else
        # Not enough room for both halves. Drop the right half to just the
        # clock (it is the one part worth keeping) and give the rest to the
        # left, so a narrow header degrades instead of truncating the right
        # text into the left one ("aupdates 40" read as one word).
        right="  ${BOLD}${now}${R} "
        vislen "$right"; rw=$VLEN
        local room=$(( iw - rw ))
        if ((room < 12)); then
            # narrower still: clock only, left side dropped entirely
            line=$right
        else
            fit "$left" "$room"
            line="${REPLY}${right}"
        fi
    fi

    t=" $APP $VER "
    rep '─' $(( w - 3 - ${#t} ))
    HEADER_LINES=("${C_BRD}┌─${C_TTL}${t}${C_BRD}${REPLY}┐${R}")
    fit "$line" "$iw"
    HEADER_LINES+=("${C_BRD}│${R}${REPLY}${C_BRD}│${R}")
    rep '─' "$iw"
    HEADER_LINES+=("${C_BRD}└${REPLY}┘${R}")
}

build_cpu() { # W H -> CPUL
    local w=$1 h=$2
    local iw=$(( w - 2 ))
    P_W=$w; P_LINES=()
    p_start "CPU"

    local bar_s tv uv pv fv cv tp=0 up=0 line mx
    if [[ -n $D_CPU ]]; then
        disp_name "$D_CPU"; trunc "$REPLY" $((iw - 1)); p_row " ${C_LBL}${REPLY}${R}"
    fi

    local bw=$(( iw - 32 ))
    ((bw > 22)) && bw=22
    ((bw < 6)) && bw=6

    # package temperature
    reading "$i_temp" 1; tv=$VALUE
    local tcol=$C_DIM
    if [[ $tv != "--" ]]; then
        tp=${tv%.*}; temp_color "$tp"; tcol=$REPLY
    fi
    temp_bar "$tp" "$bw"; bar_s=$REPLY
    hmax H_CT; mx=$REPLY
    local tshow=$tv
    [[ $tv != "--" ]] && tshow+="°C"
    p_row " ${C_LBL}temp ${R}${tcol}${BOLD}$(printf '%7s' "$tshow")${R} ${bar_s} ${C_DIM}peak $mx°${R}"

    # total usage
    reading "$i_use" 1; uv=$VALUE
    local ucol=$C_DIM
    if [[ $uv != "--" ]]; then
        up=${uv%.*}; pct_color "$up"; ucol=$REPLY
    fi
    bar "$up" "$bw"; bar_s=$REPLY
    local ushow=$uv
    [[ $uv != "--" ]] && ushow+="%"
    p_row " ${C_LBL}use  ${R}${ucol}${BOLD}$(printf '%7s' "$ushow")${R} ${bar_s}"

    # power / fan / clock / core voltage
    reading "$i_pwr" 1; pv=$VALUE; [[ $pv != "--" ]] && pv+=" W"
    reading "$i_fan" 0; fv=$VALUE; [[ $fv != "--" ]] && fv+=" RPM"
    if ((i_clk == -2)); then
        if [[ -n ${CK[0]:-} ]]; then clk_fmt "${CK[0]}"; cv=$REPLY
        else cv="--"; fi
    else
        reading "$i_clk" 0
        if [[ $VALUE == "--" ]]; then cv="--"
        else clk_fmt "$VALUE"; cv=$REPLY; fi
    fi
    reading "$i_vcore" 3; local vv=$VALUE; [[ $vv != "--" ]] && vv+=" V"
    p_row " ${C_LBL}pwr ${R}${C_VAL}${pv}${R}  ${C_LBL}fan ${R}${C_VAL}${fv}${R}  ${C_LBL}clk ${R}${C_VAL}${cv}${R}"
    p_row " ${C_LBL}vcore ${R}${C_VAL}${vv}${R}"

    # Per-core grid and graphs share what is left: the grid shows as many
    # rows as it can while still leaving the graph a couple of rows, and the
    # graph scales up when the grid is short. On a tall panel both are full.
    local nt=${#CT[@]} nu=${#CU[@]} nk=${#CK[@]}
    local ncore=$nt
    ((nu < ncore)) && ncore=$nu
    local free=$(( h - 1 - ${#P_LINES[@]} ))
    local grid_rows graph_h per cellw
    if ((ncore > 0)); then
        per=2
        cellw=$(( (iw - 2) / 2 ))
        ((cellw > 46)) && cellw=46
        if ((cellw < 26)); then per=1; cellw=$(( iw - 2 )); fi
        grid_rows=$(( (ncore + per - 1) / per ))
        graph_h=$(( free / 3 ))
        ((graph_h < 2)) && graph_h=2
        local max_grid=$(( free - graph_h - 1 ))
        ((max_grid < 1)) && max_grid=1
        ((grid_rows > max_grid)) && grid_rows=$max_grid
        ((grid_rows < 0)) && grid_rows=0
        if ((grid_rows >= 1)); then
            p_rule "cores ($ncore)"
            local k ci ri=0 row seg tn un tc2 c2
            while ((ri < grid_rows)); do
                row=""
                for ((k = 0; k < per; k++)); do
                    ci=$(( ri * per + k ))
                    if ((ci >= ncore)); then fit "" "$cellw"; row+=$REPLY; continue; fi
                    tn=${CT[ci]}; un=${CU[ci]}
                    tc2=$C_DIM
                    [[ -n $tn ]] && { temp_color "${tn%.*}"; tc2=$REPLY; }
                    [[ -z $tn ]] && tn="--"
                    [[ -z $un ]] && un="--"
                    local un_n=0
                    [[ $un != "--" ]] && un_n=${un%.*}
                    bar "$un_n" 5
                    local b2=$REPLY          # REPLY is the cell's only channel:
                    c2=""                    # every helper below overwrites it
                    if [[ -n ${CK[ci]:-} ]]; then
                        clk_fmt "${CK[ci]}"
                        c2=" ${C_DIM}$(printf '%5s' "$REPLY")${R}"
                    else
                        c2=" ${C_DIM}    -${R}"
                    fi
                    seg=" ${C_DIM}$(printf '%2s' "${CTK[ci]}")${R} ${tc2}$(printf '%3s' "${tn%.*}")°${R} ${b2}${C_DIM}$(printf '%5s' "${un}%")${R}${c2}"
                    fit "$seg" "$cellw"
                    row+=$REPLY
                done
                p_row "$row"; ((ri++))
            done
        fi
    fi

    # Graphs take the tail. Temperatures autoscale; usage is always 0..100.
    local left=$(( h - 1 - ${#P_LINES[@]} ))
    if ((left >= 6)); then
        p_graph_temp H_CT 3 " temp"
        p_graph H_CP $(( left - 3 )) 100 " use" 0
    elif ((left >= 2)); then
        p_graph H_CP "$left" 100 " use" 0
    fi
    p_finish "$h"
    CPUL=("${P_LINES[@]}")
}

build_mem() { # W H -> MEML
    local w=$1 h=$2
    local iw=$(( w - 2 ))
    P_W=$w; P_LINES=()
    p_start "MEMORY"

    # Figures only, no gauge: the numbers say more than a bar did, and a bar
    # cannot show 6833/19200 convincingly at 20 cells wide. Total is taken
    # from the server when it publishes one, else used+available.
    mem_line() { # mem_line LABEL USED TOTAL LOAD -> loads $MEMLINE
        local lbl=$1 u=$2 t=$3 p=$4 pct
        if [[ $p == "--" && $u != "--" && $t != "--" ]] && (( t > 0 )); then
            pct=$(( u * 100 / t ))
        elif [[ $p != "--" ]]; then
            pct=${p}
        else
            pct=""
        fi
        local shown_u=$u shown_t=$t
        [[ $u == "--" ]] && shown_u="--"
        [[ $t == "--" ]] && shown_t="--"
        local col=$C_DIM
        [[ -n $pct ]] && { pct_color "${pct%.*}"; col=$REPLY; }
        local ps="--"
        [[ -n $pct ]] && ps=$(printf '%3s' "${pct%.*}")"%"
        MEMLINE=" ${C_LBL}${lbl}${R} ${col}${BOLD}$(printf '%7s' "$shown_u")${R}${C_DIM}/${R}${C_VAL}$(printf '%7s' "$shown_t")${R} ${C_DIM}MB${R} ${col}${ps}${R}"
    }

    local mu mt mp
    reading "$m_used" 0;  mu=$VALUE
    if ((m_total == -3)); then mt=$M_TOTAL_V; else reading "$m_total" 0; mt=$VALUE; fi
    reading "$m_load" 0;  mp=${VALUE%.*}
    mem_line "ram " "$mu" "$mt" "$mp"
    p_row "$MEMLINE"

    if ((h > 4)); then
        local su st sp
        reading "$s_used" 0;  su=$VALUE
        reading "$s_total" 0; st=$VALUE
        reading "$s_load" 0;  sp=${VALUE%.*}
        [[ $su == "--" ]] && su="0"
        [[ $st == "--" ]] && st="0"
        mem_line "swap" "$su" "$st" "$sp"
        p_row "$MEMLINE"
    fi

    # commit charge, labelled on its own line so it is not mistaken for RAM
    if ((h > 6)); then
        local vu vt vp
        reading "$v_used" 0;  vu=$VALUE
        if ((v_total == -3)); then vt=$V_TOTAL_V; else reading "$v_total" 0; vt=$VALUE; fi
        reading "$v_load" 0;  vp=${VALUE%.*}
        [[ $vt == "--" ]] && vt="--"
        mem_line "virt" "$vu" "$vt" "$vp"
        p_row "$MEMLINE"
    fi

    local left=$(( h - 1 - ${#P_LINES[@]} ))
    ((left >= 2)) && p_graph H_ML "$left" 100 " ram" 0
    p_finish "$h"
    MEML=("${P_LINES[@]}")
}

build_gpu() { # W H -> GPUL
    local w=$1 h=$2
    local iw=$(( w - 2 ))
    P_W=$w; P_LINES=()
    p_start "GPU"

    if ((g_temp < 0 && g_load < 0 && g_mt < 0)); then
        ((h > 3)) && p_row " ${C_DIM}no GPU sensor in this HWiNFO tree${R}"
        p_finish "$h"; GPUL=("${P_LINES[@]}"); return
    fi
    local gsen=""
    if ((g_temp >= 0)); then gsen=${S_SEN[g_temp]}
    elif ((g_load >= 0)); then gsen=${S_SEN[g_load]}; fi
    if [[ -n $gsen && $h -gt 5 ]]; then
        disp_name "$gsen"; trunc "$REPLY" $((iw - 1)); p_row " ${C_LBL}${REPLY}${R}"
    fi

    local bw=$(( iw - 28 ))
    ((bw > 26)) && bw=26
    ((bw < 6)) && bw=6

    local tv hv tv_n tp=0 tcol=$C_DIM bar_s line
    reading "$g_temp" 1; tv=$VALUE
    reading "$g_hot" 1;  hv=$VALUE
    if [[ $tv != "--" ]]; then
        tp=${tv%.*}; temp_color "$tp"; tcol=$REPLY
    fi
    temp_bar "$tp" "$bw"; bar_s=$REPLY
    line=" ${C_LBL}temp ${R}${tcol}${BOLD}$(printf '%5s' "$tv°C")${R} ${bar_s}"
    [[ $hv != "--" ]] && line+=" ${C_LBL}hot ${R}${C_VAL}${hv}°C${R}"
    p_row "$line"

    if ((h > 6)); then
        local lv=0 lvs
        reading "$g_load" 0; lvs=$VALUE
        [[ $lvs != "--" ]] && lv=$lvs
        bar "$lv" "$bw"; bar_s=$REPLY
        p_row " ${C_LBL}load ${R}${bar_s} ${C_VAL}$(printf '%3s' "$lvs")%${R}"
    fi

    # vram: most trees have "used" but no "total" reading, so show used alone
    # (MB) and only add the /total + bar pair when a total actually exists
    if ((h > 7 && g_mu >= 0)); then
        local mu=0 mt=0 mpv=0 mline
        reading "$g_mu" 0; [[ $VALUE != "--" ]] && mu=$VALUE
        mline=" ${C_LBL}vram ${R}${C_VAL}$(printf '%7s' "$mu") MB${R}"
        if ((g_mt >= 0)); then
            reading "$g_mt" 0; [[ $VALUE != "--" ]] && mt=$VALUE
            ((mt > 0)) && mpv=$(( mu * 100 / mt ))
            bar "$mpv" "$bw"; mline+=" ${bar_s} ${C_VAL}${mpv}%${R}"
        fi
        p_row "$mline"
    fi

    if ((h > 8)); then
        local pv fv cv
        reading "$g_pwr" 1; pv=$VALUE; [[ $pv != "--" ]] && pv+="W"
        reading "$g_fan" 0; fv=$VALUE; [[ $fv != "--" ]] && fv+="RPM"
        reading "$g_clk" 0; cv=$VALUE; [[ $cv != "--" ]] && cv+="MHz"
        p_row " ${C_LBL}pwr ${R}${C_VAL}${pv}${R}  ${C_LBL}fan ${R}${C_VAL}${fv}${R}  ${C_LBL}clk ${R}${C_VAL}${cv}${R}"
    fi

    local left=$(( h - 1 - ${#P_LINES[@]} ))
    ((left >= 2)) && p_graph_temp H_GT "$left" " temp"
    p_finish "$h"
    GPUL=("${P_LINES[@]}")
}

build_net() { # W H -> NETL
    local w=$1 h=$2
    local iw=$(( w - 2 ))
    P_W=$w; P_LINES=()
    p_start "NETWORK"

    if ((n_dn < 0 && n_up < 0)); then
        ((h > 3)) && p_row " ${C_DIM}no network sensor in this HWiNFO tree${R}"
        p_finish "$h"; NETL=("${P_LINES[@]}"); return
    fi

    local dv du uv uu bar_s
    reading "$n_dn" 1; dv=$VALUE
    du=""
    [[ $dv != "--" ]] && { unit_of "$n_dn"; du=${REPLY%;}; }
    reading "$n_up" 1; uv=$VALUE
    uu=""
    [[ $uv != "--" ]] && { unit_of "$n_up"; uu=${REPLY%;}; }

    p_row " ${C_OK}▼ ${C_LBL}down ${R}${C_VAL}$(printf '%10s' "$dv") ${du}${R}"
    if ((h > 2)); then
        p_row " ${C_ACC2}▲ ${C_LBL}up   ${R}${C_VAL}$(printf '%10s' "$uv") ${uu}${R}"
    fi
    local left=$(( h - 1 - ${#P_LINES[@]} ))
    if ((left >= 2)); then
        # both directions share one axis so the two graphs are comparable
        local dm um
        hmax H_DN; dm=$REPLY
        hmax H_UP; um=$REPLY
        ((um > dm)) && dm=$um
        ((dm < 1)) && dm=1
        p_graph H_DN $(( (left + 1) / 2 )) "$dm" " down" 0
        ((left > 2)) && p_graph H_UP $(( left / 2 )) "$dm" " up" 0
    fi
    p_finish "$h"
    NETL=("${P_LINES[@]}")
}

build_others() { # W H -> OTHL
    local w=$1 h=$2
    local iw=$(( w - 2 ))
    P_W=$w; P_LINES=()
    p_start "SENSORS"

    local -a picks=()
    local i
    for i in "${!S_NAM[@]}"; do
        is_used "$i" && continue
        case ${S_TYP[i]} in
            1|2|3|5|6|7) picks+=("$i") ;;
        esac
    done
    if ((${#picks[@]} == 0)); then
        ((h > 3)) && p_row " ${C_DIM}nothing else reported by the sensor tree${R}"
        p_finish "$h"; OTHL=("${P_LINES[@]}"); return
    fi

    local rows=$(( h - 2 ))
    ((rows < 1)) && rows=1
    # column-major so the eye reads down each column, continuing to the right
    local per=$(( (${#picks[@]} + rows - 1) / rows ))
    ((per < 1)) && per=1
    local maxper=$(( iw / 26 ))
    ((maxper < 1)) && maxper=1
    ((per > maxper)) && per=$maxper
    local cellw=$(( iw / per ))
    local shown=$(( per * rows ))
    ((${#picks[@]} < shown)) && shown=${#picks[@]}

    local r c idx ci row seg nm vl un vp nw vcol
    for ((r = 0; r < rows; r++)); do
        ((${#P_LINES[@]} >= h - 1)) && break
        row=""
        for ((c = 0; c < per; c++)); do
            ci=$(( c * rows + r ))
            seg=""
            if ((ci < shown)); then
                idx=${picks[ci]}
                nm=${S_NAM[idx]}; vl=${S_VAL[idx]}; un=${S_UNI[idx]}
                short_name "$nm"; nm=$REPLY
                toint "$vl"; num_color "${S_TYP[idx]}" "$REPLY"; vcol=$REPLY
                vp=$vl
                [[ -n $un ]] && vp+=" $un"
                nw=$(( cellw - ${#vp} - 3 ))
                ((nw < 6)) && nw=6
                trunc "$nm" "$nw"; seg=" ${REPLY} ${vcol}${vp}${R}"
            fi
            fit "$seg" $(( cellw - 1 ))
            row+="${REPLY} "
            ((c == per - 1)) && row=${row% }
        done
        p_row "$row"
    done
    if ((shown < ${#picks[@]})); then
        p_row " ${C_DIM}… $(( ${#picks[@]} - shown )) more (widen the terminal)${R}"
    fi
    p_finish "$h"
    OTHL=("${P_LINES[@]}")
}

build_footer() { # W -> FOOTER_LINES
    local w=$1 iw=$(( w - 2 )) l
    l=" "
    ((PAUSED)) && l+="${C_WARN}PAUSED${R}  "
    ((STALE)) && l+="${C_BAD}link lost${R}  "
    l+="${C_LBL}q${R} quit  ${C_LBL}p${R} pause  ${C_LBL}+-${R} interval  ${C_LBL}r${R} rescan  ${C_LBL}h${R} help"
    rep '─' "$iw"
    FOOTER_LINES=("${C_BRD}┌${REPLY}┐${R}")
    fit "$l" "$iw"
    FOOTER_LINES+=("${C_BRD}│${R}${REPLY}${C_BRD}│${R}")
    rep '─' "$iw"
    FOOTER_LINES+=("${C_BRD}└${REPLY}┘${R}")
}

# -------------------------------------------------------------------- frame
# Vertical layout, wide terminal (>=104 cols):
#
#   header
#   ┌ CPU (package, usage, pwr/fan/clk, per-core grid) ┐┌ GPU              ┐
#   │                                                 ││ MEMORY           │
#   │                                                 ││ NETWORK          │
#   └─────────────────────────────────────────────────┘└──────────────────┘
#   ┌ SENSORS (full width, everything not shown above) ───────────────────┐
#   footer
#
# Heights are allocated exactly: the right column is split top-down by
# priority (GPU, memory, network) and the sensors strip takes a fixed share
# of the remaining rows, so no panel can overrun its neighbour.

alloc_right() { # ROWS -> GPUH MEMH NETH  (sums to ROWS exactly)
    # Right column priority: GPU needs ~9 rows to show all its readings plus a
    # graph, memory 6, and the rest goes to the network graphs.
    local r=$1
    GPUH=0 MEMH=0 NETH=0
    if ((r < 6)); then GPUH=$r; return 0; fi
    GPUH=$(( r * 45 / 100 ))
    ((GPUH > 12)) && GPUH=12
    ((GPUH < 7)) && GPUH=7
    # ram + swap + virt + a graph row, so 7
    MEMH=7
    ((r < 20)) && MEMH=6
    ((r < 16)) && MEMH=4
    if ((r < 12)); then
        MEMH=0
        GPUH=$(( r * 55 / 100 ))
        ((GPUH < 6)) && GPUH=6
    fi
    NETH=$(( r - GPUH - MEMH ))
    if ((NETH < 3)); then
        NETH=0
        MEMH=$(( r - GPUH ))
        ((MEMH < 0)) && { MEMH=0; GPUH=$r; }
    fi
    if ((MEMH < 0)); then MEMH=0; fi
    return 0
}

render_frame() { # W H -> FRAME_LINES
    local w=$1 h=$2 bodyh sensorh upper
    # 40x12 is the smallest frame that still fits header, footer and a panel.
    # Clamping here as well as at the terminal probe keeps every caller -- and
    # any future one -- inside the same contract.
    ((w < 40)) && w=40
    ((h < 12)) && h=12
    build_header "$w"
    bodyh=$(( h - 6 ))
    ((bodyh < 5)) && bodyh=5
    local -a out=("${HEADER_LINES[@]}")

    if ((w >= 104 && bodyh >= 14)); then
        sensorh=$(( bodyh * 32 / 100 ))
        ((sensorh < 6)) && sensorh=6
        ((sensorh > 14)) && sensorh=14
        ((sensorh > bodyh - 10)) && sensorh=$(( bodyh - 10 ))
        ((sensorh < 4)) && sensorh=4
        upper=$(( bodyh - sensorh ))

        local lw=$(( w * 46 / 100 ))
        ((lw < 48)) && lw=48
        local rw=$(( w - lw ))

        build_cpu "$lw" "$upper"
        local -a L=("${CPUL[@]}")

        alloc_right "$upper"
        build_gpu "$rw" "$GPUH"; local -a Rr=("${GPUL[@]}")
        build_mem "$rw" "$MEMH"; Rr+=("${MEML[@]}")
        build_net "$rw" "$NETH"; Rr+=("${NETL[@]}")
        local i n=${#L[@]}
        ((${#Rr[@]} < n)) && n=${#Rr[@]}
        for ((i = 0; i < n; i++)); do out+=("${L[i]}${Rr[i]}"); done

        build_others "$w" "$sensorh"
        out+=("${OTHL[@]}")
    elif ((bodyh >= 8)); then
        # medium: CPU over memory, sensors dropped
        local cpuh=$(( bodyh - 4 ))
        ((cpuh < 6)) && cpuh=6
        build_cpu "$w" "$cpuh"; out+=("${CPUL[@]}")
        build_mem "$w" "$(( bodyh - cpuh ))"; out+=("${MEML[@]}")
    else
        build_cpu "$w" "$bodyh"; out+=("${CPUL[@]}")
    fi

    build_footer "$w"
    out+=("${FOOTER_LINES[@]}")
    FRAME_LINES=("${out[@]}")
}

# ---------------------------------------------------------------------- TUI
TERM_RESTORED=0
restore_term() {
    ((TERM_RESTORED)) && return
    TERM_RESTORED=1
    printf '%s[0m%s[?25h%s[?1049l' "$E" "$E" "$E"
    stty echo 2>/dev/null
    cleanup_tmp
}

refresh() { # poll + detect + record history (no-op while paused)
    if ! poll_read; then
        # the API omits readings it is not monitoring, so a vanished value must
        # never be shown as if it were live; once the link has been down for a
        # few polls, drop the numbers instead of freezing the last good frame
        if ((LINE_LOST >= 3)); then
            S_SEN=() S_NAM=() S_TYP=() S_VAL=() S_UNI=()
            detect
        fi
        return 1
    fi
    detect
    sample_histories
    return 0
}

sample_histories() { # record one sample per polled quantity
    local v
    reading "$i_temp" 0; [[ $VALUE != "--" ]] && hpush H_CT "${VALUE%.*}"
    reading "$i_use"  0; [[ $VALUE != "--" ]] && hpush H_CP "${VALUE%.*}"
    reading "$g_temp" 0; [[ $VALUE != "--" ]] && hpush H_GT "${VALUE%.*}"
    reading "$m_load" 0
    if [[ $VALUE == "--" ]]; then
        reading "$m_used" 0; local mu=$VALUE
        reading "$m_total" 0; local mt=$VALUE
        if [[ $mu != "--" && $mt != "--" ]] && ((mt > 0)); then VALUE=$(( mu * 100 / mt )); fi
    fi
    [[ $VALUE =~ ^[0-9]+$ ]] && hpush H_ML "$VALUE"
    toint "${S_VAL[n_dn]:-}"; hpush H_DN "$REPLY"
    toint "${S_VAL[n_up]:-}"; hpush H_UP "$REPLY"
    return 0
}

show_help() { # W H - overlay the key map, wait for a key
    local w=$1 h=$2
    local -a raw=(
        "keys|"
        "k|q          quit"
        "k|p          pause / resume polling"
        "k|+  -       poll interval: 1s steps, 100ms steps below 1s"
        "k|r          reload the sensor database and re-detect sensors"
        "k|h          this help"
        "k|"
        "h|about"
        "t|"
        "t|hwapiTop polls /api/sensors/read and matches every value against the sensor database from /api/sensors/sdb, so units and grouping come from the server instead of guesses in the client."
        "t|"
        "t|A reading HWiNFO is not monitoring is omitted from the response. It is shown as -- rather than left at its last value, and after three failed polls every reading is dropped instead of frozen."
    )

    local bw=$(( w - 8 ))
    ((bw > 70)) && bw=70
    ((bw < 32)) && bw=$(( w - 2 ))
    local inner=$(( bw - 2 ))

    # wrap to the panel, then draw
    local -a body=()
    local item kind text line
    for item in "${raw[@]}"; do
        kind=${item%%|*}
        text=${item#*|}
        if [[ -z $text ]]; then body+=(""); continue; fi
        while ((${#text} > inner - 2)); do
            line=${text:0:$((inner - 2))}
            # break on the last space so words are not cut in half
            if [[ $line == *" "* ]]; then
                line=${line% *}
                body+=("${line}")
                text=${text:${#line}+1}
            else
                body+=("$line")
                text=${text:$((inner - 2))}
            fi
        done
        body+=("$text")
    done

    local ph=$(( ${#body[@]} + 2 ))
    local top=$(( (h - ph) / 2 ))
    ((top < 0)) && top=0
    local left=$(( (w - bw) / 2 ))
    ((left < 0)) && left=0
    rep ' ' "$left"; local pad=$REPLY

    local i buf="${E}[H"
    for ((i = 0; i < h; i++)); do buf+="${E}[$((i + 1));1H${E}[K"; done
    local title=" help "
    local rule=$(( bw - 3 - ${#title} ))
    ((rule < 1)) && rule=1
    rep '─' "$rule"
    buf+="${E}[$((top + 1));1H${pad}${C_BRD}┌─${C_TTL}${title}${C_BRD}${REPLY}┐${R}"
    for ((i = 0; i < ${#body[@]}; i++)); do
        fit " ${body[i]}" "$inner"
        buf+="${E}[$((top + i + 2));1H${pad}${C_BRD}│${R}${REPLY}${C_BRD}│${R}"
    done
    rep '─' $(( bw - 2 ))
    buf+="${E}[$((top + ${#body[@]} + 2));1H${pad}${C_BRD}└${REPLY}┘${R}"
    printf '%s%s' "$buf" "$R"
    read -rsn1 -t 30 _ || true
    printf '%s[2J' "$E"
}

run_tui() {
    printf '%s[?1049h%s[?25l%s[2J' "$E" "$E" "$E"
    stty -echo 2>/dev/null
    trap 'restore_term; exit 0' INT TERM
    trap 'restore_term' EXIT

    local next=0 now key wait_f i line
    while :; do
        now=${EPOCHREALTIME}      # seconds.micros, bash 5 builtin clock
        if ((!PAUSED && ${now%.*} >= next)); then
            refresh
            next=$(awk -v e="${now%.*}" -v ms="$INT_MS" 'BEGIN{printf "%d", e + ms/1000 + 0.5}')
        fi
        get_size
        render_frame "$W" "$H"
        local buf="${E}[H"
        for ((i = 0; i < H; i++)); do
            line=${FRAME_LINES[i]:-}
            buf+="${E}[$((i + 1));1H${line}${E}[K"
        done
        printf '%s%s' "$buf" "$R"

        # key wait: sub-second waits need a fractional -t so 100ms polling
        # stays responsive; read -t accepts decimals in bash 4+
        wait_f=30
        ((!PAUSED)) && wait_f=$(awk -v n="$next" -v e="$EPOCHREALTIME" 'BEGIN{d=n-e; printf "%.2f", (d<0.03?0.03:d)}')
        if read -rsn1 -t "$wait_f" key; then
            case $key in
                q|Q) break ;;
                p|P) PAUSED=$(( !PAUSED )); ((PAUSED)) || next=0 ;;
                +|=)
                    # below 1s step by 100ms, above by 1s (INT_MS+=100 inside
                    # (( )) reads as a variable named INT_MS+=100 -> use $(( )))
                    if ((INT_MS < 1000)); then INT_MS=$((INT_MS + 100)); else INT_MS=$((INT_MS + 1000)); fi
                    ((INT_MS > 60000)) && INT_MS=60000
                    iv_show; next=0 ;;
                -|_)
                    if ((INT_MS <= 1000)); then INT_MS=$((INT_MS - 100)); else INT_MS=$((INT_MS - 1000)); fi
                    ((INT_MS < 100)) && INT_MS=100
                    iv_show; next=0 ;;
                r|R) load_sdb; refresh; next=0 ;;
                h|H) show_help "$W" "$H" ;;
            esac
        fi
    done
}

# -------------------------------------------------------------- plain modes
print_snapshot() {
    local ts tv uv gv mstr nstr
    ts=$(date +%H:%M:%S)
    printf '%s  %s  poll %ss%s\n' "$ts" "$BASE_URL" "$INTERVAL" "${SRV_VER:+  api v$SRV_VER}"
    val_of "$i_temp" >/dev/null; fmtval "$REPLY" 1; tv=${REPLY:-?}
    val_of "$i_use"  >/dev/null; fmtval "$REPLY" 1; uv=${REPLY:-?}
    val_of "$g_temp" >/dev/null; fmtval "$REPLY" 1; gv=${REPLY:-?}
    local oname="${D_CPU:-unknown sensor}"
    disp_name "$oname"
    printf 'cpu   %6s°C  %5s%%  %s\n' "$tv" "$uv" "$REPLY"
    local mu mt mp
    val_of "$m_used"  >/dev/null; fmtval "$REPLY" 0; mu=${REPLY:-?}
    if ((m_total == -3)); then mt=$M_TOTAL_V; else val_of "$m_total" >/dev/null; fmtval "$REPLY" 0; mt=${REPLY:-?}; fi
    val_of "$m_load"  >/dev/null; fmtval "$REPLY" 0; mp=${REPLY:-?}
    printf 'mem   %s/%s MB  %s%%\n' "$mu" "$mt" "$mp"
    printf 'gpu   %6s°C\n' "$gv"
    local dv du uv2 uu
    val_of "$n_dn" >/dev/null; fmtval "$REPLY" 1; dv=${REPLY:-?}; unit_of "$n_dn"; du=$REPLY
    val_of "$n_up" >/dev/null; fmtval "$REPLY" 1; uv2=${REPLY:-?}; unit_of "$n_up"; uu=$REPLY
    printf 'net   down %s %s  up %s %s\n' "$dv" "$du" "$uv2" "$uu"
    [[ -n $LAST_ERR ]] && printf 'error %s\n' "$LAST_ERR"
    return 0
}

print_list() {
    # machine-oriented dump: original server names + the short English label
    # that the UI shows, so a reading can be traced between both views
    local i tname sn dn
    printf '%-34s %-34s %-6s %-10s %-6s %s\n' "SENSOR" "READING" "TYPE" "VALUE" "UNIT" "LABEL"
    for i in "${!S_NAM[@]}"; do
        case ${S_TYP[i]} in
            0) tname=none ;; 1) tname=temp ;; 2) tname=volt ;; 3) tname=fan ;;
            4) tname=amp ;;  5) tname=pwr ;;  6) tname=clk ;; 7) tname=use ;;
            8) tname=other ;; *) tname="t${S_TYP[i]}" ;;
        esac
        short_name "${S_NAM[i]}"; sn=$REPLY
        disp_name "${S_SEN[i]}"; dn=$REPLY
        printf '%-34.34s %-34.34s %-6s %-10.10s %-6.6s %s\n' \
            "${S_SEN[i]}" "${S_NAM[i]}" "$tname" "${S_VAL[i]}" "${S_UNI[i]}" "$dn | $sn"
    done
}

# refresh the display form of the interval from the internal ms value
iv_show() {
    INTERVAL=$(printf '%d.%03d' $(( INT_MS / 1000 )) $(( INT_MS % 1000 )))
    INTERVAL=${INTERVAL%.000}    # 2.000 -> 2, keep 0.300 / 1.500 as-is
}

# --------------------------------------------------------------------- main
if ! connect; then
    printf '%s: cannot reach the HWiNFO API at %s\n' "$APP" "$URL_ARG" >&2
    printf '  tried: %s\n' "${CANDIDATES[*]}" >&2
    printf '  last error: %s\n' "${CONNECT_ERR:-unknown}" >&2
    # curl exit codes tell apart "nothing answered" from "answered wrongly",
    # and the fix is completely different for each
    case ${CONN_RC:-} in
        7)
            cat >&2 <<'EOF'
  hints: connection refused - the host is up but nothing listens on that port.
    - start the server in HWiNFO's Remote Center (Start button) and use the
      exact address it shows
    - check the port: HWiNFO defaults to 8080, but the Remote Center may use
      another one
EOF
            ;;
        28)
            cat >&2 <<'EOF'
  hints: connection timed out - no reply at all, so packets are being dropped.
    - the address or port is probably wrong, or the server binds only to its
      own loopback interface instead of the LAN
    - check the firewall on the machine running HWiNFO (Windows Defender
      usually needs an inbound rule for the Remote Center port)
    - check that both machines are on the same network and that the IP has
      not changed (DHCP)
EOF
            ;;
        6|35|51|60)
            cat >&2 <<'EOF'
  hints: TLS problem - the certificate is not trusted or the scheme is wrong.
    - the tool accepts self-signed certificates by default; if you passed
      --verify, drop it or install the certificate
    - try the other scheme explicitly: --url http://<host>:<port>
EOF
            ;;
        *)
            cat >&2 <<'EOF'
  hints:
    - start the server in HWiNFO's Remote Center (Start button) and note its URL
    - pass the exact address, e.g. --url http://192.168.1.50:8080
    - a TLS error means the certificate is not trusted; this tool skips
      verification by default (add --verify to require a trusted cert)
    - connection refused means nothing listens there (IP, port, firewall)
    - a timeout means nothing answered at all (wrong IP, firewall, or the
      server is bound to loopback only)
EOF
            ;;
    esac
    exit 1
fi

if ! load_sdb; then
    printf '%s: warning: sensor database unavailable (%s); units will be missing\n' \
        "$APP" "$LAST_ERR" >&2
fi

case $MODE in
    list)
        refresh || { printf '%s: %s\n' "$APP" "${LAST_ERR:-read failed}" >&2; exit 1; }
        print_list
        ;;
    once)
        refresh || { printf '%s: %s\n' "$APP" "${LAST_ERR:-read failed}" >&2; exit 1; }
        print_snapshot
        ;;
    render)
        W=${RENDER_SPEC%x*} H=${RENDER_SPEC#*x}
        [[ $W =~ ^[0-9]+$ ]] || W=80
        [[ $H =~ ^[0-9]+$ ]] || H=24
        # a single poll would leave every graph collapsed into one wall of
        # blocks, so warm the histories with a few quick samples first
        for ((_warm = 0; _warm < 40; _warm++)); do
            refresh || break
            sleep 0.03
        done
        detect
        render_frame "$W" "$H"
        local_i=0
        for local_i in "${FRAME_LINES[@]}"; do printf '%s\n' "$local_i"; done
        ;;
    tui)
        if [[ ! -t 1 ]]; then
            printf '%s: stdout is not a terminal; use --once or --list\n' "$APP" >&2
            exit 1
        fi
        refresh || true
        run_tui
        ;;
esac
cleanup_tmp
exit 0
