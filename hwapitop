#!/usr/bin/env bash
# hwapiTop - a btop-style terminal monitor for the HWiNFO sensor REST API.
#
#   ./hwapitop --url 192.168.1.50
#   ./hwapitop --url http://192.168.1.50:8080 --interval 2
#   ./hwapitop --url 192.168.1.50 --once     one snapshot, no TUI
#   ./hwapitop --url 192.168.1.50 --list     dump the sensor table
#
# The HWiNFO REST API separates static description from live values:
#   GET /api/sensors/sdb   sensor tree + units + tooltips (load once)
#   GET /api/sensors/read  values only, polled
#   GET /api/ping          reachability + RTT
# Every JSON carries a root "Version" (currently 1) that must be checked.
#
# The API omits a reading that HWiNFO is not monitoring (hidden, or monitoring
# paused) instead of reporting a stale value, so a missing reading is shown as
# -- and never carried over from the previous poll. After three failed polls
# in a row every reading is dropped and the header switches to NO DATA, so a
# frozen frame can never be mistaken for a live one.
#
# Keys (TUI): q quit | p pause | + - interval | r reload sensor db | h help
# Requires: bash >= 4.3, curl, jq.

set -uo pipefail
shopt -s extglob

# Parsing and formatting must be locale independent: with LC_NUMERIC=ru_RU
# printf both emits "48,6" and rejects "48.6" as an argument. The API always
# uses '.' as the decimal separator in its JSON numbers, and reading values
# are parsed after stripping display separators.
export LC_NUMERIC=C

APP="hwinfoTop"
VER="0.0.1"

# ------------------------------------------------------------------ options
URL_ARG=""
INTERVAL=2                 # CLI form, seconds (integer or 0.1-steps below 1)
INT_MS=2000                # internal poll period, milliseconds
TIMEOUT=5
VERIFY_TLS=0
MODE="tui"                 # tui | once | list | render
RENDER_SPEC=""
PAUSED=0
NO_COLOR_ENV=${NO_COLOR:-}

usage() {
    cat <<EOF
$APP $VER - monitor a HWiNFO REST API server in the terminal

usage: $APP --url <host> [options]

  --url <host>        server address: 192.168.1.50 | 192.168.1.50:8080 |
                      http://host:port | https://host:port
                      Without a scheme https:// is tried first, then http://,
                      because HWiNFO serves a self-signed certificate by default.
                      A missing port means 8080.
  -i, --interval <s>  poll interval in seconds; fractional values (0.1 .. 0.9)
                      poll in 100ms steps (default $INTERVAL; the sensor source
                      itself updates about every 2 s)
  -t, --timeout <s>   per-request timeout in seconds (default $TIMEOUT)
      --verify        verify the TLS certificate (default: accept self-signed)
      --once          print one snapshot and exit (no TUI, works without a tty)
      --list          print the sensor table (name, type, value, unit) and exit
      --no-color      disable colors
  -h, --help          this help

keys in the TUI:  q quit   p pause   + - interval   r reload sensors   h help

examples:
  $APP --url 192.168.1.50
  $APP --url 192.168.1.50:8080 --interval 3
  $APP --url http://192.168.1.50:8080 --once

EOF
}

while (($#)); do
    case $1 in
        --url)        URL_ARG=${2:-}; shift 2 2>/dev/null || shift ;;
        --url=*)      URL_ARG=${1#*=}; shift ;;
        -i|--interval) INTERVAL=${2:-2}; shift 2 2>/dev/null || shift ;;
        -i=*|--interval=*) INTERVAL=${1#*=}; shift ;;
        -t|--timeout) TIMEOUT=${2:-5}; shift 2 2>/dev/null || shift ;;
        -t=*|--timeout=*) TIMEOUT=${1#*=}; shift ;;
        --verify)     VERIFY_TLS=1; shift ;;
        --once)       MODE=once; shift ;;
        --list)       MODE=list; shift ;;
        --no-color)   NO_COLOR_ENV=1; shift ;;
        --render)     MODE=render; RENDER_SPEC=${2:-80x24}; shift 2 2>/dev/null || shift ;;
        -h|--help)    usage; exit 0 ;;
        *) printf '%s: unknown argument %s (see --help)\n' "$APP" "$1" >&2; exit 2 ;;
    esac
done

# interval: seconds, fractional allowed below 1 (100 ms granularity).
# Stored internally as integer milliseconds so +/- and the scheduler stay exact.
if [[ $INTERVAL =~ ^([0-9]+)(\.([0-9]+))?$ ]]; then
    INT_MS=$(( ${BASH_REMATCH[1]} * 1000 ))
    if [[ -n ${BASH_REMATCH[3]:-} ]]; then
        dec="1${BASH_REMATCH[3]}"      # 1-prefix kills the octal trap
        dec=${dec:0:4}
        while (( ${#dec} < 4 )); do dec+="0"; done
        INT_MS=$(( INT_MS + dec - 1000 ))
    fi
else
    INTERVAL=2; INT_MS=2000
fi
((INT_MS < 100))   && INT_MS=100
((INT_MS > 60000)) && INT_MS=60000
INTERVAL=$(printf '%d.%03d' $(( INT_MS / 1000 )) $(( INT_MS % 1000 )))
INTERVAL=${INTERVAL%.000}
[[ $TIMEOUT =~ ^[0-9]+$ ]] || TIMEOUT=5

if [[ -z $URL_ARG ]]; then
    printf '%s: --url <host> is required (try --help)\n' "$APP" >&2
    exit 2
fi
for dep in curl jq; do
    command -v "$dep" >/dev/null 2>&1 || { printf '%s: %s is required\n' "$APP" "$dep" >&2; exit 1; }
done

# ------------------------------------------------------------------- colors
if [[ -n $NO_COLOR_ENV ]]; then
    E=""; BOLD=""; R=""
    C_BRD=""; C_TTL=""; C_LBL=""; C_VAL=""; C_DIM=""; C_OK=""; C_WARN=""; C_BAD=""; C_ACC=""; C_ACC2=""
else
    E=$'\033' BOLD=$'\033[1m' R=$'\033[0m'
    C_BRD=$'\033[38;5;240m'
    C_TTL=$'\033[1;38;5;51m'
    C_LBL=$'\033[38;5;245m'
    C_VAL=$'\033[38;5;253m'
    C_DIM=$'\033[38;5;239m'
    C_OK=$'\033[38;5;48m'
    C_WARN=$'\033[38;5;220m'
    C_BAD=$'\033[38;5;203m'
    C_ACC=$'\033[38;5;45m'
    C_ACC2=$'\033[38;5;213m'
fi

# ------------------------------------------------------------- text helpers
E_PAD=$(printf '%200s' '')
rep() { # rep CHAR N -> REPLY (N copies of CHAR)
    local c=$1 n=$2
    ((n < 0)) && n=0
    ((n > 200)) && n=200
    REPLY=${E_PAD:0:n}
    REPLY=${REPLY// /$c}
}

vislen() { # vislen TEXT -> VLEN visible column count (ANSI and wide-char aware)
    local s=$1 chars=() n=0 w c
    if [[ -z $NO_COLOR_ENV ]]; then s=${s//$E\[*([0-9;])m/}; fi
    if [[ $s != *[!\ -~]* ]]; then VLEN=${#s}; return 0; fi   # fast path: pure ASCII
    # UTF-8: count code points, charge 2 columns for wide (CJK, box/block, emoji)
    while IFS= read -r -d '' c; do
        case $c in
            ─|│|┌|┐|└|┘|├|┤) n=$((n + 1)) ;;
            █|░|▁|▂|▃|▄|▅|▆|▇) n=$((n + 1)) ;;
            *) n=$((n + 1)) ;;
        esac
    done < <(printf '%s' "$s" | while IFS= read -r -n1 c; do printf '%s\0' "$c"; done)
    VLEN=$n
}

fit() { # fit TEXT WIDTH -> REPLY exactly WIDTH visible columns (truncates if needed)
    local s=$1 w=$2 plain
    if [[ -z $NO_COLOR_ENV ]]; then plain=${s//$E\[*([0-9;])m/}; else plain=$s; fi
    if ((${#plain} <= w)); then
        rep ' ' $((w - ${#plain}))
        REPLY="$s$REPLY"
        return 0
    fi
    local c out="" n=0
    while IFS= read -r -n1 c && ((n < w)); do
        out+=$c; n=$((n + 1))
    done <<<"$plain"
    REPLY=$out
}

trunc() { # trunc TEXT WIDTH -> REPLY plain text, at most WIDTH chars, '~' marks a cut
    local s=$1 w=$2
    if ((${#s} <= w)); then REPLY=$s
    elif ((w <= 0)); then REPLY=""
    elif ((w == 1)); then REPLY=${s:0:1}
    else REPLY="${s:0:w-1}~"
    fi
}

bar() { # bar PERCENT WIDTH -> REPLY colored bar, exactly WIDTH cells
    local p=$1 w=$2 f col full empty
    ((w < 1)) && { REPLY=""; return 0; }
    ((p < 0)) && p=0
    ((p > 100)) && p=100
    f=$(( (p * w + 50) / 100 ))
    ((f > w)) && f=w
    pct_color "$p"; col=$REPLY
    rep '█' "$f"; full=$REPLY
    rep '░' $((w - f)); empty=$REPLY
    REPLY="${col}${full}${C_DIM}${empty}${R}"
}

clk_fmt() { # clk_fmt VALUE -> REPLY compact clock ("4.69G" / "498M")
    # Frequency columns are the tightest part of a core row, so GHz is spelled
    # with a single letter; the unit is consistent across the whole grid.
    local v=${1//,/}
    REPLY=$1
    [[ $v =~ ^([0-9]+)(\.[0-9]*)?$ ]] || return 0
    local whole=${BASH_REMATCH[1]}
    local frac=${BASH_REMATCH[2]:-}
    if ((whole >= 1000)); then
        # 4691 -> "4.69G": whole GHz plus two decimals of MHz
        local ghz=$(( whole / 1000 ))
        local d1=$(( (whole / 100) % 10 ))
        local d2=$(( (whole / 10) % 10 ))
        REPLY="${ghz}.${d1}${d2}G"
    else
        REPLY="${whole}M"
    fi
}

temp_bar() { # temp_bar DEGC WIDTH -> REPLY bar spanning T_LO..T_HI
    # A temperature bar on a 0..100 scale is wrong for a CPU: idling at 45 C
    # would fill nearly half the bar and 100 C would not look alarming. The
    # bar therefore spans the same -10..120 range as the colour ramp, so the
    # fill position and the colour tell the same story.
    local t=${1%.*} w=$2 f col full empty
    ((w < 1)) && { REPLY=""; return 0; }
    [[ $t =~ ^-?[0-9]+$ ]] || { rep '░' "$w"; REPLY="${C_DIM}${REPLY}${R}"; return 0; }
    ((t < T_LO)) && t=$T_LO
    ((t > T_HI)) && t=$T_HI
    f=$(( (t - T_LO) * w / (T_HI - T_LO) ))
    ((f > w)) && f=w
    temp_color "$t"; col=$REPLY
    rep '█' "$f"; full=$REPLY
    rep '░' $((w - f)); empty=$REPLY
    REPLY="${col}${full}${C_DIM}${empty}${R}"
}

pct_color() {
    if (($1 >= 85)); then REPLY=$C_BAD
    elif (($1 >= 65)); then REPLY=$C_WARN
    else REPLY=$C_OK; fi
}
T_LO=-10   # cold end of the temperature ramp, degrees C
T_HI=120   # hot end, degrees C

temp_color() { # temp_color DEGC -> REPLY 256-colour for that temperature
    # A smooth ramp reads a trace at a glance where three bands do not. Below
    # T_LO it stays at the coldest blue and above T_HI at the hottest red, so
    # an out-of-range probe cannot throw the scale off.
    #
    # Anchors are interpolated rather than stepped: a three-band version made
    # everything from 60 to 90 C the same yellow, which is exactly the range a
    # hot core lives in and so the part worth telling apart.
    local t=${1%.*} pos r g b
    [[ $t =~ ^-?[0-9]+$ ]] || t=0
    ((t < T_LO)) && t=$T_LO
    ((t > T_HI)) && t=$T_HI
    pos=$(( (t - T_LO) * 100 / (T_HI - T_LO) ))     # 0..100 along the ramp

    # anchor positions and their colours (blue, cyan, green, yellow, red)
    local -a ap=( 0 18 40 62 82 100 )
    local -a ar=( 0  0  0  90 255 255 )
    local -a ag=( 40 190 235 255 210  20 )
    local -a ab=( 255 255 120  0   0   0 )

    local k=0 span p0 p1 fr
    for ((k = 0; k < ${#ap[@]} - 1; k++)); do
        ((pos >= ap[k] && pos <= ap[k + 1])) && break
    done
    ((k >= ${#ap[@]} - 1)) && k=$((${#ap[@]} - 2))
    p0=${ap[k]}; p1=${ap[k + 1]}
    span=$(( p1 - p0 ))
    ((span < 1)) && span=1
    fr=$(( (pos - p0) * 100 / span ))               # 0..100 inside the segment
    r=$(( ar[k] + (ar[k + 1] - ar[k]) * fr / 100 ))
    g=$(( ag[k] + (ag[k + 1] - ag[k]) * fr / 100 ))
    b=$(( ab[k] + (ab[k + 1] - ab[k]) * fr / 100 ))

    # the 16..231 cube holds 6 steps per channel: scale 0..255 onto 0..5
    r=$(( (r * 5 + 127) / 255 ))
    g=$(( (g * 5 + 127) / 255 ))
    b=$(( (b * 5 + 127) / 255 ))
    REPLY=$'\033[38;5;'$(( 16 + 36 * r + 6 * g + b ))'m'
}

num_color() { # num_color TYPE VALUE -> REPLY
    case $1 in
        1) temp_color "$2" ;;
        7) pct_color "$2" ;;
        *) REPLY=$C_VAL ;;
    esac
}

toint() { # toint STRING -> REPLY integer, 0 when not numeric
    local v=${1//,/}
    if [[ $v =~ ^(-?[0-9]+)(\.[0-9]*)?$ ]]; then REPLY=$((10#${BASH_REMATCH[1]}))
    else REPLY=0; fi
}

fmtval() { # fmtval VALUE DIGITS -> REPLY formatted number; empty string when not numeric
    local v=${1//,/} d=${2:-1}
    if [[ $v =~ ^-?[0-9]+(\.[0-9]+)?$ ]]; then
        printf -v REPLY "%.${d}f" "$v"
    else REPLY=""; fi
}

# ---------------------------------------------------------------- box panels
# Panels are line arrays built by the build_* functions. Every helper below
# appends exactly one full-width line, so a panel is just a sequence of them.
P_W=0
P_LINES=()

p_start() { # TITLE
    local t=" $1 "
    if ((${#t} > P_W - 3)); then trunc "$1" $((P_W - 4)); t=" $REPLY "; fi
    rep '─' $(( P_W - 3 - ${#t} ))
    P_LINES+=("${C_BRD}┌─${C_TTL}${t}${C_BRD}${REPLY}┐${R}")
}
p_row() { # CONTENT
    fit "$1" $(( P_W - 2 ))
    P_LINES+=("${C_BRD}│${R}${REPLY}${C_BRD}│${R}")
}
p_blank() { p_row ""; }
p_rule() { # TITLE
    local t=${1:-} iw=$(( P_W - 2 ))
    if [[ -n $t ]]; then
        rep '─' $(( iw - ${#t} - 2 ))
        p_row "${C_DIM}─${C_LBL}${t}${C_DIM}${REPLY}─${R}"
    else
        rep '─' "$iw"
        P_LINES+=("${C_BRD}├${REPLY}┤${R}")
    fi
}
p_end() {
    rep '─' $(( P_W - 2 ))
    P_LINES+=("${C_BRD}└${REPLY}┘${R}")
}
p_finish() { # HEIGHT: pad or clip the panel so it has exactly HEIGHT lines
    local h=$1
    while ((${#P_LINES[@]} < h - 1)); do p_blank; done
    if ((${#P_LINES[@]} > h - 1)); then P_LINES=("${P_LINES[@]:0:h-1}"); fi
    p_end
}

# reading accessors (indices may be -1 meaning "not present")
val_of() {
    if (($1 >= 0 && $1 < ${#S_VAL[@]})); then REPLY=${S_VAL[$1]}; else REPLY=""; fi
}
unit_of() {
    if (($1 >= 0 && $1 < ${#S_UNI[@]})); then REPLY=${S_UNI[$1]}; else REPLY=""; fi
}

# ---------------------------------------------------------------- terminal
H=24 W=80
get_size() {
    local s
    s=$(stty size 2>/dev/null)
    if [[ $s =~ ^([0-9]+)[[:space:]]+([0-9]+)$ ]]; then
        H=${BASH_REMATCH[1]} W=${BASH_REMATCH[2]}
    else
        W=$(tput cols 2>/dev/null || echo 80)
        H=$(tput lines 2>/dev/null || echo 24)
    fi
    [[ $W =~ ^[0-9]+$ ]] || W=80
    [[ $H =~ ^[0-9]+$ ]] || H=24
    ((W < 40)) && W=40
    ((H < 12)) && H=12
}

# ------------------------------------------------------------------ http
TMPD=$(mktemp -d "${TMPDIR:-/tmp}/hwapitop.XXXXXX") || { echo "$APP: no temp dir" >&2; exit 1; }
BODY_FILE="$TMPD/body" ERR_FILE="$TMPD/err" READ_JSON="$TMPD/read.json" SDB_JSON="$TMPD/sdb.json"
cleanup_tmp() { [[ -d $TMPD ]] && rm -rf -- "$TMPD"; }

BASE_URL="" HTTP_CODE=000 CONN_ERR="" CONN_RC="" BODY=""
api_get() { # PATH -> 0 on transport success; BODY, HTTP_CODE set
    local path=$1 rc
    local -a opts=(-sS -m "$TIMEOUT" -o "$BODY_FILE" -w '%{http_code}' -H 'Accept: application/json')
    ((VERIFY_TLS == 0)) && opts+=(-k)
    HTTP_CODE=$(curl "${opts[@]}" "${BASE_URL}${path}" 2>"$ERR_FILE"); rc=$?
    if ((rc != 0)); then
        CONN_RC=$rc
        CONN_ERR=$(tr '\n' ' ' <"$ERR_FILE"); CONN_ERR=${CONN_ERR#[0-9]*- }
        [[ -z $CONN_ERR ]] && CONN_ERR="curl error $rc"
        HTTP_CODE=000 BODY=""
        return 1
    fi
    BODY=$(<"$BODY_FILE")
    return 0
}

CANDIDATES=()
normalize_url() {
    local u=$1 scheme rest host port
    CANDIDATES=()
    if [[ $u == http://* || $u == https://* ]]; then
        scheme=${u%%://*}; rest=${u#*://}; rest=${rest%/}
        if [[ $rest == *:* ]]; then CANDIDATES=("${scheme}://${rest}")
        else CANDIDATES=("${scheme}://${rest}:8080"); fi
        return
    fi
    u=${u%/}
    if [[ $u == *:* ]]; then host=${u%%:*} port=${u##*:}; else host=$u port=8080; fi
    CANDIDATES=("https://${host}:${port}" "http://${host}:${port}")
}

CONNECT_ERR=""
connect() {
    local c
    normalize_url "$URL_ARG"
    for c in "${CANDIDATES[@]}"; do
        BASE_URL=$c
        if api_get /api/ping && [[ $HTTP_CODE == 200 ]] && [[ $BODY == *'"pong"'* ]]; then
            return 0
        fi
        CONNECT_ERR=${CONN_ERR:-HTTP $HTTP_CODE}
    done
    BASE_URL=${CANDIDATES[0]}
    return 1
}

# ------------------------------------------------------------ sensor table
# parallel arrays, one entry per reading
declare -a S_SEN=() S_NAM=() S_TYP=() S_VAL=() S_UNI=() 
SRV_VER="" STALE=0 LAST_ERR="" READ_RTT=0 READ_AGE=0
POLLS=0 LINE_LOST=0
LAST_OK=0

load_sdb() {
    if ! api_get /api/sensors/sdb; then
        LAST_ERR="sdb: ${CONN_ERR}"; return 1
    fi
    if [[ $HTTP_CODE != 200 ]]; then
        LAST_ERR="sdb: HTTP $HTTP_CODE ${BODY:0:60}"; return 1
    fi
    local v
    v=$(jq -r 'if has("Version") then .Version else "missing" end' <<<"$BODY" 2>/dev/null)
    if [[ $v != 1 ]]; then
        LAST_ERR="sdb: unsupported Version '$v'"; return 1
    fi
    printf '%s' "$BODY" >"$SDB_JSON"
    return 0
}

poll_read() {
    if ! api_get /api/sensors/read; then
        ((LINE_LOST++)); STALE=1; LAST_ERR="read: ${CONN_ERR}"; return 1
    fi
    case $HTTP_CODE in
        200) LINE_LOST=0 ;;
        503) STALE=1; LAST_ERR="read: 503 ${BODY:0:70}"; ((LINE_LOST++)); return 1 ;;
        *)   STALE=1; LAST_ERR="read: HTTP $HTTP_CODE ${BODY:0:50}"; ((LINE_LOST++)); return 1 ;;
    esac
    printf '%s' "$BODY" >"$READ_JSON"

    local v
    v=$(jq -r 'if has("Version") then .Version else "missing" end' "$READ_JSON" 2>/dev/null)
    if [[ $v != 1 ]]; then
        STALE=1; LAST_ERR="read: unsupported Version '$v'"; return 1
    fi
    SRV_VER=$v

    local tsv
    tsv=$(jq -r --slurpfile sdb "$SDB_JSON" '
        ($sdb[0] // {}) as $s
        | paths(objects | select(has("Value"))) as $p
        | ($p[-1] | tostring) as $last
        | ($p[-2] | tostring) as $prev
        | ([$last] | inside(["0","1","2","3","4","5","6","7","8"])) as $typed
        | [ ($p[0] | tostring),
            (if $typed then $prev else $last end),
            (if $typed then $last else "0" end),
            (getpath($p).Value | tostring),
            ((try ($s | getpath($p) | .Unit) catch null) // "") ]
        | @tsv' "$READ_JSON" 2>"$ERR_FILE") || {
            STALE=1; LAST_ERR="parse: $(head -c 120 "$ERR_FILE" | tr '\n' ' ')"; return 1
        }

    S_SEN=() S_NAM=() S_TYP=() S_VAL=() S_UNI=()
    local sen nam typ val uni
    while IFS=$'\t' read -r sen nam typ val uni; do
        [[ -z $sen ]] && continue
        # sdb units follow the install language ("МБ", "В", "МГц"); the UI is
        # English-only, so translate the known ones at intake
        case $uni in
            МБ) uni=MB ;; ГБ) uni=GB ;; МГц) uni=MHz ;; ГГц) uni=GHz ;;
            В)  uni=V  ;; об/мин) uni=RPM ;; °С|°C) uni=°C ;;
        esac
        S_SEN+=("$sen") S_NAM+=("$nam") S_TYP+=("$typ") S_VAL+=("$val") S_UNI+=("$uni")
    done < <(printf '%s\n' "$tsv")

    READ_RTT=$(jq -r '((.Timestamp ms // 0) - (.Timestamp RS ms // 0)) | if . > 0 then (.|floor) else 0 end' "$READ_JSON" 2>/dev/null)
    [[ $READ_RTT =~ ^[0-9]+$ ]] || READ_RTT=0
    LAST_OK=$(date +%s)
    STALE=0 LAST_ERR=""
    ((POLLS++))
    return 0
}

# -------------------------------------------------------------- detection
# Overview slots. Sensor names differ per machine, so match on reading names
# and reading types, preferring the sensor that looks like the CPU/GPU.
D_CPU="" 
i_temp=-1 i_use=-1 i_pwr=-1 i_fan=-1 i_clk=-1
g_temp=-1 g_hot=-1 g_load=-1 g_pwr=-1 g_fan=-1 g_clk=-1 g_mu=-1 g_mt=-1
m_used=-1 m_total=-1 m_load=-1
v_used=-1 v_total=-1 v_load=-1
n_dn=-1 n_up=-1
# Per-core values are kept as display strings, aligned by position with CTK
# (the vector of core numbers). Detection guarantees the three arrays are the
# same length, so the renderer cannot fall out of step with itself.
declare -a CT=() CTK=() CU=() CK=() CPUS=()
declare -a USED=()

find_idx() { # TYPE_RE NAME_RE [SENSOR_EXACT] -> REPLY index or -1
    local tr=$1 nr=$2 sr=${3:-} i
    for i in "${!S_NAM[@]}"; do
        [[ ${S_TYP[i]} =~ ^($tr)$ ]] || continue
        [[ ${S_NAM[i]} =~ $nr ]] || continue
        if [[ -n $sr && ${S_SEN[i]} != "$sr" ]]; then continue; fi
        REPLY=$i; return 0
    done
    REPLY=-1; return 1
}

# HWiNFO localises reading names, so English patterns alone miss every sensor
# on a non-English install (a Russian one reports "Общая загрузка ЦП" where an
# English one says "Total CPU Usage"). These helpers add a second way to find a
# reading: an explicit list of name variants, plus positional lookup on the SDB
# order for names that have no stable wording at all.
find_names() { # find_idx_names TYPE_RE 'RE1|RE2|RE3' [SENSOR_EXACT]
    local tr=$1 list=$2 sr=${3:-} pat i
    local -a pats
    IFS=';' read -r -a pats <<<"$list"
    for i in "${!S_NAM[@]}"; do
        [[ ${S_TYP[i]} =~ ^($tr)$ ]] || continue
        if [[ -n $sr && ${S_SEN[i]} != "$sr" ]]; then continue; fi
        for pat in "${pats[@]}"; do
            [[ -z $pat ]] && continue
            if [[ ${S_NAM[i]} =~ $pat ]]; then REPLY=$i; return 0; fi
        done
    done
    REPLY=-1; return 1
}
pick_names() { # pick_names TYPE_RE 'RE1|RE2' [SENSOR] -> REPLY idx, marks used
    find_names "$1" "$2" "${3:-}" || return 1
    USED+=("$REPLY")
    return 0
}
pick_or() { # pick_or TYPE_RE 'RE1|RE2' [SENSOR] -> REPLY idx (first match wins)
    pick_names "$1" "$2" "${3:-}" && return 0
    pick "$1" "$2" "${3:-}" && return 0
    return 1
}

core_num() { # core_num NAME -> CNUM core index, or empty when the name has none
    local n=$1
    # "Core 5", "Core 5 Clock", "P-core 3 Usage", "CPU Core 7"
    [[ $n =~ (^|[^0-9])([0-9]+) ]] || { CNUM=""; return 1; }
    CNUM=$((10#${BASH_REMATCH[2]}))
    return 0
}

find_all() { # TYPE_RE NAME_RE [SENSOR_EXACT] -> indices, one per line
    local tr=$1 nr=$2 sr=${3:-} i
    for i in "${!S_NAM[@]}"; do
        [[ ${S_TYP[i]} =~ ^($tr)$ ]] || continue
        [[ ${S_NAM[i]} =~ $nr ]] || continue
        if [[ -n $sr && ${S_SEN[i]} != "$sr" ]]; then continue; fi
        printf '%s\n' "$i"
    done
}

pick() { # pick TYPE_RE NAME_RE [SENSOR_EXACT] -> REPLY idx, marks used
    find_idx "$1" "$2" "${3:-}" || return 1
    USED+=("$REPLY")
    return 0
}

CORE_RE='[Cc]ore[[:space:]]*([0-9]+)'

in_group() { # in_group SENSOR -> 0 when the sensor is part of the CPU group
    local g
    for g in "${CPUS[@]}"; do [[ $1 == "$g" ]] && return 0; done
    return 1
}

pick_grp() { # pick_grp TYPE_RE 'RE1|RE2' -> REPLY idx inside the CPU group
    local tr=$1 list=$2 pat i
    local -a pats
    IFS=';' read -r -a pats <<<"$list"
    for i in "${!S_NAM[@]}"; do
        [[ ${S_TYP[i]} =~ ^($tr)$ ]] || continue
        in_group "${S_SEN[i]}" || continue
        for pat in "${pats[@]}"; do
            [[ -z $pat ]] && continue
            if [[ ${S_NAM[i]} =~ $pat ]]; then USED+=("$i"); REPLY=$i; return 0; fi
        done
    done
    REPLY=-1; return 1
}

detect() {
    D_CPU="" i_temp=-1 i_use=-1 i_pwr=-1 i_fan=-1 i_clk=-1 i_vcore=-1
    g_temp=-1 g_hot=-1 g_load=-1 g_pwr=-1 g_fan=-1 g_clk=-1 g_mu=-1 g_mt=-1
    m_used=-1 m_avail=-1 m_total=-1 m_load=-1
    v_used=-1 v_avail=-1 v_total=-1 v_load=-1 V_TOTAL_V=0
    s_used=-1 s_total=-1 s_load=-1 M_TOTAL_V=0
    n_dn=-1 n_up=-1
    CT=() CTK=() CU=() CK=() USED=() CPUS=()

    # ---- which sensor is the CPU? score by tell-tale readings.
    # Reading names are localised, so every pattern here has an English and a
    # Russian form; an English-only pattern finds nothing on a Russian HWiNFO.
    local -A score=() i s
    for i in "${!S_SEN[@]}"; do
        s=${S_SEN[i]}
        [[ $s =~ ^(GPU|dGPU|.*NVIDIA.*|.*Radeon.*|.*Graphics.*) ]] && continue
        [[ ${S_NAM[i]} =~ (Total CPU Usage|CPU Total Usage|CPU Utilization|Общая загрузка ЦП) ]] && score[$s]=$(( ${score[$s]:-0} + 10 ))
        [[ ${S_NAM[i]} =~ (CPU Package|Tctl|Tdie|CPU Temperature|ЦП \(Tctl) ]]           && score[$s]=$(( ${score[$s]:-0} + 6 ))
        [[ ${S_NAM[i]} =~ (Core Clock|Core VID|CPU Core Voltage|Напряжение ядра|Частота ядер) ]] && score[$s]=$(( ${score[$s]:-0} + 3 ))
    done
    local best=-1
    for s in "${!score[@]}"; do
        if (( ${score[$s]} > best )); then best=${score[$s]}; D_CPU=$s; fi
    done
    ((best <= 0)) && D_CPU=""

    # ---- every sensor belonging to that CPU. HWiNFO splits extra readings
    # ("Enhanced", "C-State") into their own sub-sensors, and a given reading
    # may live in any of them, so per-core data must be gathered across all.
    CPUS=()
    if [[ -n $D_CPU ]]; then
        local base=$D_CPU
        local sub_re='^(.*[^:]) *: +(Enhanced|C-State.*|Power|Clocks?|Voltages?)$'
        [[ $base =~ $sub_re ]] && base=${BASH_REMATCH[1]}
        local seen=" "
        for i in "${!S_SEN[@]}"; do
            s=${S_SEN[i]}
            [[ $s == "$base" || $s == "$base":* ]] || continue
            [[ $seen == *" $s "* ]] && continue
            seen+="$s "; CPUS+=("$s")
        done
        ((${#CPUS[@]})) || CPUS=("$base")
    fi

    # ---- package-level CPU readings
    if [[ -n $D_CPU ]]; then
        pick_grp 1 'CPU Package;;CPU \(Tctl/Tdie\);;Tctl;;Tdie;;Package Temperature;;CPU Temperature;;ЦП \(Tctl|Кристалл ЦП' \
            || pick_grp 1 '.' >/dev/null
        i_temp=$REPLY
        pick_grp 7 'Total CPU Usage;;CPU Total Usage;;Total CPU Utilization;;CPU Usage;;Общая загрузка ЦП;;^Использование ядра' && i_use=$REPLY
        pick_grp 5 'CPU Package Power;;Package Power;;^CPU Power;;Полная потребляемая мощность;;^ЦП PPT$' && i_pwr=$REPLY
        # the CPU-fan reading often lives in the motherboard sensor ("ЦП1"
        # on Russian boards, "CPU Fan"/"Fan #1" elsewhere), not in the CPU
        # group itself — so fall back to a global search for it
        pick_grp 3 'CPU Fan;;^Fan;;^ЦП1$' || pick_names 3 'CPU Fan;;^Fan [0-9]?$;;^Fan$;;^ЦП1$' || true
        i_fan=$REPLY
        # A bus clock is not what anyone means by "clock": take the core clock
        # aggregate first, then core 0, and only then fall back to the bus.
        pick_grp 6 '^Частоты ядер$;;^Core Clocks$;;^CPU Clock$;;^CPU Core Clock$' && i_clk=$REPLY
        ((i_clk < 0)) && { pick_grp 6 '^Частота ГП$' >/dev/null 2>&1; i_clk=-1; }
        ((i_clk < 0)) && { pick_grp 6 'Bus Clock;;Частота шины' && i_clk=$REPLY; }
        # The VID average is a request, not a rail; prefer the measured core
        # voltage when the sensor publishes one.
        pick_grp 2 'Напряжение ядра ЦП;;CPU Core Voltage;;^Core Voltage$;;^Vcore$;;ЦП Core VID' && i_vcore=$REPLY
        ((i_vcore < 0)) && { pick_grp 2 '^Core VIDs$;;^CPU Core Voltage$' && i_vcore=$REPLY; }
    fi
    ((i_temp < 0)) && { pick_names 1 'CPU Package;;CPU Temperature;;Tctl;;ЦП \(Tctl|Кристалл ЦП' && i_temp=$REPLY; }
    ((i_use  < 0)) && { pick_names 7 'Total CPU Usage;;CPU Total Usage;;Общая загрузка ЦП' && i_use=$REPLY; }
    ((i_vcore < 0)) && { pick_names 2 'CPU Core Voltage;;^Vcore$;;Напряжение ядра ЦП' && i_vcore=$REPLY; }

    # ---- per-core readings, keyed by core number so temp/usage/clock line up
    # even when the three live in different sub-sensors.
    local -A c_t=() c_k=() u_t=() u_n=()
    local cn v tenth
    for i in "${!S_SEN[@]}"; do
        in_group "${S_SEN[i]}" || continue
        [[ ${S_NAM[i]} =~ $CORE_RE ]] || continue
        cn=$((10#${BASH_REMATCH[1]}))
        case ${S_TYP[i]} in
            1) [[ -z ${c_t[$cn]:-} ]] && c_t[$cn]=$i ;;
            6) if [[ ${S_NAM[i]} =~ (Частота|Clock|MHz) && ! ${S_NAM[i]} =~ (Эффективн|Effective) ]]; then
                   [[ -z ${c_k[$cn]:-} ]] && c_k[$cn]=$i
               fi ;;
            7) v=${S_VAL[i]//,/}
               if [[ $v =~ ^(-?[0-9]+)(\.([0-9]))?$ ]]; then
                   tenth=$(( 10#${BASH_REMATCH[1]} * 10 ))
                   [[ -n ${BASH_REMATCH[3]:-} ]] && tenth=$(( tenth + 10#${BASH_REMATCH[3]} ))
                   u_t[$cn]=$(( ${u_t[$cn]:-0} + tenth ))
                   u_n[$cn]=$(( ${u_n[$cn]:-0} + 1 ))
               fi ;;
        esac
    done

    # every core that has any reading, in numeric order
    local -A all=() 
    for cn in "${!c_t[@]}"; do all[$cn]=1; done
    for cn in "${!u_t[@]}"; do all[$cn]=1; done
    for cn in "${!c_k[@]}"; do all[$cn]=1; done
    local -a cnums=()
    ((${#all[@]})) && while read -r cn; do
        [[ -n $cn ]] && cnums+=("$cn")
    done < <(printf '%s\n' "${!all[@]}" | sort -n)

    local avg
    for cn in "${cnums[@]}"; do
        CTK+=("$cn")
        if [[ -n ${c_t[$cn]:-} ]]; then
            CT+=("${S_VAL[c_t[$cn]]}"); USED+=("${c_t[$cn]}")
        else CT+=(""); fi
        if [[ -n ${u_t[$cn]:-} && ${u_n[$cn]:-0} -gt 0 ]]; then
            avg=$(( u_t[$cn] / u_n[$cn] ))
            CU+=("$(( avg / 10 )).$(( avg % 10 ))")
            [[ -n ${c_t[$cn]:-} ]] || true
            # every thread reading of this core counts as consumed
            for i in "${!S_NAM[@]}"; do
                [[ ${S_TYP[i]} == 7 ]] || continue
                in_group "${S_SEN[i]}" || continue
                [[ ${S_NAM[i]} =~ $CORE_RE ]] || continue
                (( 10#${BASH_REMATCH[1]} == cn )) && USED+=("$i")
            done
        else CU+=(""); fi
        if [[ -n ${c_k[$cn]:-} ]]; then
            CK+=("${S_VAL[c_k[$cn]]}"); USED+=("${c_k[$cn]}")
        else CK+=(""); fi
    done
    # HWiNFO usually has no package-wide clock; core 0 is a fine stand-in
    if ((i_clk < 0)) && ((${#CK[@]} > 0)) && [[ -n ${CK[0]} ]]; then i_clk=-2; fi

    # ---- GPU: prefer a sensor that actually reports a temperature or a load
    local gsen=""
    gsen=$(find_names '1|7' 'Температура ГП|GPU Temperature|GPU Core Load|Использование ГП|GPU Load' && printf '%s' "${S_SEN[REPLY]}")
    if [[ -z $gsen ]]; then
        for i in "${!S_SEN[@]}"; do
            if [[ ${S_SEN[i]} =~ ^(GPU|dGPU|.*NVIDIA.*|.*Radeon.*) ]]; then gsen=${S_SEN[i]}; break; fi
        done
    fi
    if [[ -n $gsen ]]; then
        pick_names 1 '^Температура ГП$;;^GPU Temperature$;;^GPU Temp' "$gsen" && g_temp=$REPLY
        pick_names 1 'Температура горячей точки;;Hot ?Spot;;Hotspot' "$gsen" && g_hot=$REPLY
        pick_names 7 '^Использование ГП$;;GPU Core Load;;GPU Utilization;;^GPU Load$' "$gsen" && g_load=$REPLY
        pick_names 5 'Общая мощность графики;;GPU Power;;Board Power' "$gsen" && g_pwr=$REPLY
        pick_names 3 '^GPU Вентилятор$;;GPU Fan;;^Fan$' "$gsen" && g_fan=$REPLY
        pick_names 6 '^Частота ГП$;;GPU Core Clock;;^GPU Clock$' "$gsen" && g_clk=$REPLY
        # physical VRAM only: "GPU Memory Usage" also counts shared/system
        # pages (24GB "used" on a 12GB card), D3D Dedicated is the on-card part
        pick_names 8 '^Выделенная память D3D ГП$;;GPU D3D Memory Dedicated;;GPU Memory Used' "$gsen" && g_mu=$REPLY
        pick_names 8 'GPU Memory Total;;Общий объем памяти ГП' "$gsen" && g_mt=$REPLY
    fi

    # ---- memory: the system sensor has no single "total" reading, so total
    # is reconstructed as used + available, which HWiNFO keeps consistent.
    pick_names 8 'Используемая физическая память;;^Physical Memory Used$;;^Memory Used$;;^Used Physical Memory$' && m_used=$REPLY
    pick_names 8 'Доступная физическая память;;^Physical Memory Available$' && m_avail=$REPLY
    pick_names 8 '^Physical Memory Total$;;^Memory Total$' && m_total=$REPLY
    pick_names 8 'Загрузка физической памяти;;^Physical Memory Load$;;^Memory Load$;;^Total Memory Usage$' && m_load=$REPLY
    # HWiNFO publishes no total on this sensor, only used and available, so the
    # total is the SUM OF THE VALUES. Summing the table indices instead once
    # produced "8407/1024 MB" -- plausible-looking and completely wrong.
    if ((m_total < 0)) && ((m_used >= 0 && m_avail >= 0)); then
        local _u _a
        val_num "$m_used"; _u=$REPLY
        val_num "$m_avail"; _a=$REPLY
        if [[ -n $_u && -n $_a ]]; then m_total=-3; M_TOTAL_V=$(( _u + _a )); fi
    fi

    # swap / page file
    pick_names 8 '^Page File Total$;;Файл подкачки.*(Всего|Общий)' && s_total=$REPLY
    pick_names 8 '^Page File Used$;;Файл подкачки.*Использ' && s_used=$REPLY
    pick_names 7 'Использование файла подкачки;;^Page File Usage$' && s_load=$REPLY

    # virtual memory (commit)
    pick_names 8 'Выделенная виртуальная память;;^Virtual Memory Committed$;;^Commit Charge$' && v_used=$REPLY
    pick_names 8 'Доступная виртуальная память;;^Virtual Memory Available$' && v_avail=$REPLY
    pick_names 8 '^Virtual Memory Total$;;^Commit Limit$' && v_total=$REPLY
    if ((v_total < 0)) && ((v_used >= 0 && v_avail >= 0)); then
        local _vu _va
        val_num "$v_used";  _vu=$REPLY
        val_num "$v_avail"; _va=$REPLY
        if [[ -n $_vu && -n $_va ]]; then v_total=-3; V_TOTAL_V=$(( _vu + _va )); fi
    fi
    pick_names 7 'Загрузка виртуальной памяти;;^Virtual Memory Load$' && v_load=$REPLY

    # network
    pick_names 8 'Текущая скорость скачивания;;Download Rate;;^DL Rate' && n_dn=$REPLY
    pick_names 8 'Текущая скорость отправки;;Upload Rate;;^UL Rate' && n_up=$REPLY
}

tonum() { fmtval "$1" 0 >/dev/null; toint "${REPLY:-0}"; }

val_num() { # val_num IDX -> REPLY integer value, empty when not numeric
    # Values arrive as display strings ("8,114" / "46.430"), so the comma has
    # to go before they can be added. Empty means "not monitored", which must
    # stay distinguishable from a genuine 0.
    val_of "$1"
    local v=${REPLY//,/}
    if [[ $v =~ ^(-?[0-9]+)(\.[0-9]*)?$ ]]; then REPLY=$((10#${BASH_REMATCH[1]}))
    else REPLY=""; fi
}

is_used() { local u; for u in "${USED[@]}"; do [[ $u == "$1" ]] && return 0; done; return 1; }

val_of() { # val_of IDX -> REPLY raw value or ""
    local i=$1
    if ((i >= 0 && i < ${#S_VAL[@]})); then REPLY=${S_VAL[i]}; else REPLY=""; fi
}
unit_of() {
    local i=$1
    if ((i >= 0 && i < ${#S_UNI[@]})); then REPLY=${S_UNI[i]}; else REPLY=""; fi
}

